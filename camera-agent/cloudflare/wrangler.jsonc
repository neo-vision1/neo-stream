{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neo-vision-camera",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/api/*", "/health", "/auth-config"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMERA_SITE",
        "class_name": "CameraSite"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CameraSite"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
